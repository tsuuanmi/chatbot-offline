# Environment
CHATBOT_ENV=production

# Runtime
CHATBOT_RUNTIME_DIR=./runtime
MODEL_DIR=./runtime/models

# llama.cpp
LLAMA_MODEL_NAME=gemma-4-E2B-it-Q4_K_M.gguf
LLAMA_MODEL_ALIAS=forensic-model
LLAMA_CTX_SIZE=8192
LLAMA_THREADS=8

# PostgreSQL
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot

# CPU embedding
EMBEDDING_THREADS=4

# Conversation persistence
CHAT_OWNER_ID=local-development
HISTORY_TURN_LIMIT=6
