# Environment
CHATBOT_ENV=production

# Runtime
# Container access to mounted runtime secrets
# Set to the group that owns runtime/secrets on the host.
CHATBOT_SECRET_GID=1000

CHATBOT_RUNTIME_DIR=./runtime
MODEL_DIR=./runtime/models

# Nginx gateway

# llama.cpp
LLAMA_MODEL_NAME=gemma-4-E2B-it-Q4_K_M.gguf
LLAMA_MODEL_ALIAS=forensic-model
LLAMA_CTX_SIZE=8192
LLAMA_THREADS=8

# PostgreSQL
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot

# CPU embedding
EMBEDDING_THREADS=4

# Conversation persistence
HISTORY_TURN_LIMIT=6

# Conversation context safety limits
HISTORY_CHAR_LIMIT=8000
CHAT_MESSAGE_MAX_CHARS=8000
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=18080
